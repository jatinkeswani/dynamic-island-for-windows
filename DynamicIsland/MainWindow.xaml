<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island"
        Width="560" Height="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" AllowDrop="True"
        KeyDown="Window_KeyDown"
        DragEnter="Window_DragOver" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryText" Color="#8EFFFFFF" />
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#2C2C2E" />
        <SolidColorBrush x:Key="TimerAccent" Color="#FF9F0A" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#17FFFFFF" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Round icon button: instant hover tint, press scales down with a strong ease-out -->
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="999" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="RenderTransform.ScaleX">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="0.88" KeySpline="0.23,1 0.32,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="RenderTransform.ScaleY">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="0.88" KeySpline="0.23,1 0.32,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="RenderTransform.ScaleX">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="1" KeySpline="0.23,1 0.32,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="RenderTransform.ScaleY">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="1" KeySpline="0.23,1 0.32,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#26FFFFFF" CornerRadius="12" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="6,5">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#17FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#59000000" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#99000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Canvas x:Name="Root">
        <Canvas.RenderTransform>
            <ScaleTransform x:Name="IslandScale" />
        </Canvas.RenderTransform>

        <!-- The island's shape (tab, liquid neck, drop, pill or panel), rebuilt every animation frame -->
        <Path x:Name="Body" Cursor="Hand"
              MouseLeftButtonDown="Body_MouseLeftButtonDown" MouseLeftButtonUp="Body_MouseLeftButtonUp" MouseLeave="Body_MouseLeave">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0C0C0E" Offset="0" />
                    <GradientStop Color="#000000" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
            <Path.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.45" Color="Black" />
            </Path.Effect>
            <Path.ContextMenu>
                <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                    <MenuItem Header="Settings…" Click="Settings_Click" />
                    <MenuItem Header="Quit Dynamic Island" Click="Quit_Click" />
                </ContextMenu>
            </Path.ContextMenu>
        </Path>

        <!-- Gloss: soft sheen on the upper half and a subtle bright edge -->
        <Path x:Name="Gloss" IsHitTestVisible="False" StrokeThickness="1">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#17FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.5" />
                </LinearGradientBrush>
            </Path.Fill>
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                    <GradientStop Color="#0DFFFFFF" Offset="0.6" />
                    <GradientStop Color="#24FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>

        <!-- Content, clipped to the island's body -->
        <Canvas x:Name="ContentLayer">

            <!-- Compact pill: shows the current activity -->
            <Grid x:Name="Compact" Height="34" IsHitTestVisible="False">
                <Grid x:Name="CompactMedia" Visibility="Collapsed">
                    <Border x:Name="ArtSmall" Width="22" Height="22" CornerRadius="6"
                            HorizontalAlignment="Left" Margin="6,0,0,0" Background="{StaticResource ArtPlaceholder}">
                        <TextBlock x:Name="ArtSmallGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1" ScaleY="0.35" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2" ScaleY="0.35" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3" ScaleY="0.35" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <Grid x:Name="CompactTimer" Visibility="Collapsed">
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource TimerAccent}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" />
                    <TextBlock x:Name="CompactTimerText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TimerAccent}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                </Grid>

                <Grid x:Name="CompactShelf" Visibility="Collapsed">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" />
                    <TextBlock x:Name="CompactShelfText" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                </Grid>
            </Grid>

            <!-- Timer alert: replaces the panel when a timer ends; clicking the island dismisses it -->
            <Grid x:Name="AlertPanel" Width="340" Height="84" Opacity="0" IsHitTestVisible="False">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24" Background="#33FF9F0A">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource TimerAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Timer ended" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="AlertDetail" FontSize="13" Foreground="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Expanded panel: fixed size so controls stay put once the island settles -->
            <Grid x:Name="Expanded" Width="440" Height="336" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ExpandedScale" ScaleX="0.96" ScaleY="0.96" />
                </Grid.RenderTransform>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="138" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Music -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Clicking the artwork opens the video in picture-in-picture -->
                        <Grid x:Name="ArtButton" Width="56" Height="56" Cursor="Hand" ToolTip="Open in picture-in-picture"
                              MouseEnter="ArtButton_MouseEnter" MouseLeave="ArtButton_MouseLeave" MouseLeftButtonUp="ArtButton_Click">
                            <Border x:Name="ArtLarge" CornerRadius="12" Background="{StaticResource ArtPlaceholder}">
                                <TextBlock x:Name="ArtLargeGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                           Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ArtPipHint" CornerRadius="12" Background="#99000000" Opacity="0">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ArtistText" Text="Play something in Spotify or your browser" Foreground="{StaticResource SecondaryText}"
                                       FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PrevButton" Style="{StaticResource MediaButton}" Content="&#xE892;" IsEnabled="False" Click="Prev_Click" />
                            <Button x:Name="PlayPauseButton" Style="{StaticResource MediaButton}" Width="46" Height="46" FontSize="22"
                                    IsEnabled="False" Click="PlayPause_Click">
                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" />
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource MediaButton}" Content="&#xE893;" IsEnabled="False" Click="Next_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Timer -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource TimerAccent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Timer" Style="{StaticResource CardHeader}" Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- iOS-style minute / second wheels, shown while setting the timer -->
                                <Grid x:Name="PickerPanel" Grid.Row="1" Height="66" VerticalAlignment="Center">
                                    <Border Height="24" CornerRadius="8" Background="#1FFFFFFF" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <local:WheelPicker x:Name="MinutePicker" Width="36" Height="66" Count="60" />
                                        <TextBlock Text="min" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center" Margin="2,0,16,0" />
                                        <local:WheelPicker x:Name="SecondPicker" Width="36" Height="66" Count="60" />
                                        <TextBlock Text="sec" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Countdown, shown while running or paused -->
                                <TextBlock x:Name="TimerText" Grid.Row="1" Text="05:00" FontSize="32" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="TimerStartButton" Style="{StaticResource PillButton}" Content="Start" Click="TimerStart_Click" />
                                    <Button Style="{StaticResource PillButton}" Content="Reset" Margin="6,0,0,0" Click="TimerReset_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Audio output -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,12,8,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,4">
                                    <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                    <TextBlock Text="Output" Style="{StaticResource CardHeader}" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="OutputError" DockPanel.Dock="Top" Visibility="Collapsed" Margin="4,4,0,0" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{StaticResource SecondaryText}" Text="Couldn't read audio devices" />
                                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="OutputList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Tag="{Binding Id}" Click="Output_Click" ToolTip="{Binding Name}">
                                                    <DockPanel>
                                                        <!-- Always takes its space so every name lines up -->
                                                        <TextBlock x:Name="Check" DockPanel.Dock="Left" Width="18" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                   VerticalAlignment="Center" Foreground="{StaticResource TimerAccent}" Visibility="Hidden" />
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- File shelf -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8">
                        <Grid>
                            <StackPanel x:Name="ShelfHint" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                <TextBlock Text="Drop files here to keep them handy" FontSize="13" Foreground="{StaticResource SecondaryText}" Margin="8,0,0,0" />
                            </StackPanel>
                            <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="ShelfScroll_PreviewMouseWheel">
                                <ItemsControl x:Name="ShelfList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Tile" Width="68" CornerRadius="10" Background="Transparent" Cursor="Hand" ToolTip="{Binding Path}"
                                                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown" MouseMove="Tile_MouseMove">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Grid Width="30" Height="30">
                                                            <Image Source="{Binding Icon}" />
                                                            <TextBlock x:Name="FolderGlyph" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Center" Margin="4,4,4,0" />
                                                    </StackPanel>
                                                    <Button x:Name="Remove" Style="{StaticResource SmallIconButton}" Content="&#xE711;"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                                                            Visibility="Hidden" Click="ShelfRemove_Click" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tile" Property="Background" Value="#14FFFFFF" />
                                                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Canvas>

        <!-- Secondary activity bubble that splits off the pill's right side when two things are active -->
        <Grid x:Name="BubbleContent" Width="34" Height="34" Opacity="0" IsHitTestVisible="False">
            <Grid x:Name="BubbleMedia">
                <Ellipse x:Name="BubbleArt" Width="24" Height="24" Fill="{StaticResource ArtPlaceholder}" />
                <TextBlock x:Name="BubbleArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="BubbleShelf" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Canvas>
</Window>
